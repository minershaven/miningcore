{
    "//": "Pearl pool config. The pool talks to PEARLD (the node), which speaks",
    "//2": "standard btcd JSON-RPC: getblocktemplate / submitblock / getblockchaininfo.",
    "//3": "pearld RPC default port = 44107 (mainnet). Oyster WALLET = 44207 (used only",
    "//4": "for payouts, not implemented yet). pearld serves TLS by default; set ssl:true,",
    "//5": "pearld serves TLS by default (ssl:true; the certificate is not validated). Miners: SRBMiner-MULTI --algorithm pearlhash (3.8.4+ recommended), OneZeroMiner, suprminer.",
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "pool.log",
        "logBaseDirectory": "/home/eman/miningcorePRL/logs",
        "perPoolLogFile": true
    },
    "banning": {
        "manager": "Integrated"
    },
    "notifications": {
        "enabled": false
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "your-password",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "shareRecoveryFile": "recovered-shares.txt"
    },
    "pools": [
        {
            "id": "pearl1",
            "enabled": true,
            "coin": "pearl",
            "address": "YOUR_PEARL_TAPROOT_MINING_ADDRESS",
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": {
                "enabled": false
            },
            "ports": {
                "3001": {
                    "listenAddress": "0.0.0.0",
                    "name": "GPU",
                    "difficulty": 2000000,
                    "varDiff": {
                        "minDiff": 100000,
                        "maxDiff": null,
                        "targetTime": 10,
                        "retargetTime": 30,
                        "variancePercent": 30,
                        "maxDelta": 1000000000000.0
                    }
                }
            },
            "daemons": [
                {
                    "//": "PEARLD node RPC (NOT the oyster wallet). Mainnet RPC port 44107.",
                    "host": "127.0.0.1",
                    "port": 44107,
                    "user": "pearlrpc",
                    "password": "YOUR_PEARLD_RPC_PASSWORD",
                    "ssl": true
                },
                {
                    "//": "Oyster wallet RPC (payouts). Run oyster with noservertls=1 on localhost.",
                    "host": "127.0.0.1",
                    "port": 44207,
                    "user": "pool",
                    "password": "YOUR_OYSTER_RPC_PASSWORD",
                    "category": "wallet"
                }
            ],
            "paymentProcessing": {
                "enabled": true,
                "minimumPayment": 10,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": {
                    "factor": 2
                },
                "walletPassphrase": "YOUR_OYSTER_PRIVATE_PASSPHRASE",
                "account": "default",
                "feeRatePerKb": 0.0001,
                "minConf": 1
            },
            "maxActiveJobs": 4,
            "pythonExecutable": "/opt/pearl-venv/bin/python",
            "pythonBridgeScript": "/opt/miningcore/pearl/pearl_mining_bridge.py"
        }
    ],
    "//6": "Pool-level and paymentProcessing-level settings are plain properties (Miningcore extension data), not nested under an 'extra' key. Python env: build py-pearl-mining (maturin) + miner/miner-utils + miner/pearl-gateway from pearl-research-labs/pearl into a venv."
}
